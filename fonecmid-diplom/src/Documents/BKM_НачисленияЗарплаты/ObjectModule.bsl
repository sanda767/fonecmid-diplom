Процедура СформироватьДвиженияВзаиморасчеты()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	BKM_ОсновныеНачисления.Сотрудник КАК Сотрудник,
		|	СУММА(BKM_ОсновныеНачисления.Результат) КАК РезультатОсн,
		|	BKM_Удержания.Значение КАК РезультатУдержания
		|ИЗ
		|	РегистрРасчета.BKM_ОсновныеНачисления КАК BKM_ОсновныеНачисления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.BKM_Удержания КАК BKM_Удержания
		|		ПО BKM_ОсновныеНачисления.Сотрудник = BKM_Удержания.Сотрудник
		|		И BKM_ОсновныеНачисления.Регистратор = BKM_Удержания.Регистратор
		|ГДЕ
		|	BKM_ОсновныеНачисления.Регистратор = &Регистратор
		|СГРУППИРОВАТЬ ПО
		|	BKM_ОсновныеНачисления.Сотрудник,
		|	BKM_Удержания.Значение";
	
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Движения.BKM_ВзаиморасчетыССотрудниками.Записывать = Истина;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Движение = Движения.BKM_ВзаиморасчетыССотрудниками.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Регистратор = Ссылка;
		Движение.Сотрудник = ВыборкаДетальныеЗаписи.Сотрудник;
		Движение.Сумма = ВыборкаДетальныеЗаписи.РезультатОсн - ВыборкаДетальныеЗаписи.РезультатУдержания;
	КонецЦикла;
	
